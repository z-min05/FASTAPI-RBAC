# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/fastapi_rbac

# Redis
# 注意：Windows 下 Redis 通常只监听 IPv4，用 localhost 会先解析到 ::1 导致连接超时
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600
REFRESH_TOKEN_EXPIRE_DAYS=7

# 应用
APP_NAME=FastAPI-RBAC
DEBUG=true
API_V1_PREFIX=/api/v1

# 跨域
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# 日志
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# Agent（AI 助手）
# V2：LLM/Agent 在平台内入库管理（不再使用 AGENT_LLM_*/AGENT_SYSTEM_PROMPT 等 env 配置）
AGENT_ENABLED=true
AGENT_INVOKE_TIMEOUT=180

# 定时执行（调度器，随应用进程内嵌运行）
# 多 worker 场景下"到点判定/认领"已 DB 化（条件更新），不会重复触发
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# 任务运行超时阈值：超过该时长仍标记 running 视为僵尸并自动复位
SCHEDULER_ZOMBIE_TIMEOUT_HOURS=4

# 企业微信机器人通知：查看完整报告链接前缀（如 http://127.0.0.1:8080），留空则不附加链接
NOTIFY_FRONTEND_URL=

# 加密（api_key 敏感字段）
ENCRYPTION_KEY=

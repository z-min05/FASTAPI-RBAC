# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/fastapi_rbac

# Redis
# 注意：Windows 下 Redis 通常只监听 IPv4，用 localhost 会先解析到 ::1 导致连接超时
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600
REFRESH_TOKEN_EXPIRE_DAYS=7

# 应用
APP_NAME=FastAPI-RBAC
DEBUG=true
API_V1_PREFIX=/api/v1

# 跨域
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# 日志
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# Agent（AI 助手）
# V2：LLM/Agent 在平台内入库管理（不再使用 AGENT_LLM_*/AGENT_SYSTEM_PROMPT 等 env 配置）
AGENT_ENABLED=true
AGENT_INVOKE_TIMEOUT=180
# bash 工具的顶层工作目录（沙箱根）：每个 Agent 的工作目录固定为该目录下的
# user_<用户ID>/agent_<AgentID>，创建 Agent 时自动创建，用户无需指定。
# 留空则默认取 backend/agent_workspaces
AGENT_WORKSPACE_ROOT=
# LLM 限流退避：供应商返回 429（TPM/RPM 超限）时按 5s、10s、20s… 重试（单次上限 30s）
AGENT_LLM_MAX_RETRIES=3
AGENT_LLM_RETRY_INITIAL_DELAY=5
AGENT_LLM_RETRY_MAX_DELAY=30

# 定时执行（调度器，随应用进程内嵌运行）
# 多 worker 场景下"到点判定/认领"已 DB 化（条件更新），不会重复触发
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# 任务运行超时阈值：超过该时长仍标记 running 视为僵尸并自动复位
SCHEDULER_ZOMBIE_TIMEOUT_HOURS=4

# 自动化用例执行
# 单个用例执行超时（秒）：超过则强杀 pytest 子进程并记为失败。
# 部分用例（如 OTA 升级、组网、长距离测试）耗时远超 120s，可按需调大
EXEC_TIMEOUT_SECONDS=120

# 企业微信机器人通知：查看完整报告链接前缀（如 http://127.0.0.1:8080），留空则不附加链接
NOTIFY_FRONTEND_URL=


# Python 环境管理（Miniconda）：需按本机实际安装位置填写后启用
CONDA_ENABLED=false
# Miniconda 安装根目录（用于推导 conda 可执行文件，如 Windows 下 Scripts\conda.exe）
CONDA_HOME=
# conda 可执行文件显式路径；填了则优先于 CONDA_HOME 推导
CONDA_EXE=
# 虚拟环境存放根目录（环境路径 = 该目录/环境名）
CONDA_ENV_ROOT=
# 单条 conda 命令超时（秒）
CONDA_CMD_TIMEOUT=600
# 可供选择的 Python 版本（逗号分隔，取"主.次"版本号即可：
# conda create 时会自动装该小版本下的最新补丁版，如 3.11 会装 3.11.16）
# 下表来自 conda search python 的 anaconda/pkgs/main 频道实际可用版本
CONDA_PYTHON_VERSIONS=3.7,3.8,3.9,3.10,3.11,3.12,3.13,3.14

# 项目自动化代码初始化
# 全局自动化根目录（需预先存在且可写）：项目代码包解压到该目录下，
# 项目自动化根路径自动推导为 {该目录}/{压缩包顶层目录名}/tests
PROJECT_CODE_BASE_DIR=
# 上传 zip 大小上限（MB）
PROJECT_CODE_UPLOAD_MAX_MB=200
# 解压后总体积上限（MB），防 zip bomb
PROJECT_CODE_MAX_UNCOMPRESSED_MB=2000
# 压缩包条目数上限
PROJECT_CODE_MAX_FILES=20000
# pip install 超时（秒）
PROJECT_CODE_INIT_TIMEOUT=1800
# 上传临时目录；留空使用系统临时目录
PROJECT_CODE_TMP_DIR=

# 加密（api_key 敏感字段）
ENCRYPTION_KEY=

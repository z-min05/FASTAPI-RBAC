# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/fastapi_rbac

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600
REFRESH_TOKEN_EXPIRE_DAYS=7

# 应用
APP_NAME=FastAPI-RBAC
DEBUG=true
API_V1_PREFIX=/api/v1

# 跨域
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# 日志
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# Agent（AI 助手）
# V2：LLM/Agent 在平台内入库管理（不再使用 AGENT_LLM_*/AGENT_SYSTEM_PROMPT 等 env 配置）
AGENT_ENABLED=true
AGENT_INVOKE_TIMEOUT=180

# 加密（api_key 敏感字段）
ENCRYPTION_KEY=

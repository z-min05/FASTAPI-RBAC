# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/fastapi_rbac

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=REPLACE_WITH_YOUR_SECURE_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 应用
APP_NAME=FastAPI-RBAC
DEBUG=true
API_V1_PREFIX=/api/v1

# 跨域
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# 日志
LOG_LEVEL=INFO
